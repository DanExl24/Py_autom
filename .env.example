# ==========================================
# Variables de Entorno del Proyecto Py_autom
# ==========================================

# Configuración del Backend
PORT=3000
ENVIRONMENT=production

# URLs y Dominios en VPS
FRONTEND_URL=https://pyautom.adsoproject.dev
BACKEND_URL=https://api-pyautom.adsoproject.dev
VITE_API_URL=https://api-pyautom.adsoproject.dev

# Google OAuth 2.0 (Client ID para Login en Frontend)
# Obtén este ID en Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs (Web application)
VITE_GOOGLE_CLIENT_ID=tu-google-client-id.apps.googleusercontent.com

# Credenciales para Pruebas Playwright Sofia Plus (Opcional - solo entorno local)
SOFIA_USERNAME=tu_documento_o_usuario
SOFIA_PASSWORD=tu_contrasena_sofia

